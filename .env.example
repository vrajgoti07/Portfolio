# ========================================================
# AWDF Task Manager - Environment Configuration Template
# ========================================================
# Copy this file to .env before running locally or deploying.
# Do NOT commit actual secrets or credentials to source control.

# Application Ports & Environment
PORT=5000
NODE_ENV=production

# Database Configuration
# Local machine: mongodb://127.0.0.1:27017/awdf_db
# Docker Compose: mongodb://mongodb:27017/awdf_db
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/awdf_db
MONGO_URI=mongodb://mongodb:27017/awdf_db

# Authentication Security (JWT)
JWT_SECRET=your_jwt_secret_key_here

# Admin Account Initialization
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME="System Administrator"

# Frontend API Base URL (Accessed from Host Browser)
VITE_API_URL=http://localhost:5000

# Optional SMTP Email Service (Practical 8)
# If left blank, the application operates normally with email dispatch bypassed
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Task Manager Admin <no-reply@taskmanager.local>"
